generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id @default(uuid())
  name                String          @db.VarChar(100)
  email               String          @unique @db.VarChar(255)
  phone               String?         @db.VarChar(20)
  avatarUrl           String?         @map("avatar_url")
  coverUrl            String?         @map("cover_url")
  bio                 String?
  location            String?         @db.VarChar(100)
  language            String          @default("es") @db.VarChar(5)
  googleId            String?         @unique @map("google_id") @db.VarChar(255)
  verified            Boolean         @default(false)
  pin                 String?
  notifMessages       Boolean         @default(true) @map("notif_messages")
  notifOffers         Boolean         @default(true) @map("notif_offers")
  notifMarketing      Boolean         @default(true) @map("notif_marketing")
  showEmail           Boolean         @default(true) @map("show_email")
  showPhone           Boolean         @default(true) @map("show_phone")
  permission          PermissionAcces @default(GRANTED)
  themePreference     String          @default("system") @map("theme_preference") @db.VarChar(10)
  /// Toggle for the printable QR seller card: include phone on the card.
  /// Off by default so a shared/printed card never leaks contact info unless
  /// the seller opts in. Independent of `showPhone` (public profile).
  qrShowPhone         Boolean         @default(false) @map("qr_show_phone")
  /// Same as `qrShowPhone` but for the email row on the QR card.
  qrShowEmail         Boolean         @default(false) @map("qr_show_email")
  plan                UserPlan        @default(FREE)
  planCycle           PlanCycle       @default(MONTHLY) @map("plan_cycle")
  planStartedAt       DateTime?       @map("plan_started_at")
  planExpiresAt       DateTime?       @map("plan_expires_at")
  suspended           Boolean         @default(false)
  suspendedReason     String?         @map("suspended_reason")
  isBusiness          Boolean         @default(false) @map("is_business")
  /// Set when a manual business verification is approved. Backs the 👑 badge
  /// and the "verified" filter. Cleared to null if the verification is later
  /// revoked.
  businessVerifiedAt  DateTime?       @map("business_verified_at")
  /// Rolling median (minutes) between a buyer contacting the seller and the
  /// seller's first outbound WA/tel click. Backs the "Responde rápido" badge
  /// for Premium sellers. Recomputed by a nightly cron.
  responseTimeMinutes Int?            @map("response_time_minutes")
  lastSeenAt          DateTime?       @map("last_seen_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  products               Product[]
  favorites              Favorite[]
  reviewsGiven           Review[]              @relation("ReviewAuthor")
  reviewsReceived        Review[]              @relation("ReviewSeller")
  followers              Follower[]            @relation("Followed")
  following              Follower[]            @relation("Follower")
  rolCreated             Rol[]                 @relation("User_Create_Rol")
  notifications          Notification[]
  pushTokens             PushToken[]
  reportsMade            Report[]              @relation("ReportReporter")
  reportsReceived        Report[]              @relation("ReportReportedUser")
  reportsReviewed        Report[]              @relation("ReportReviewer")
  otpCodes               OtpCode[]
  homeSections           HomeSection[]         @relation("HomeSectionCreator")
  homeSuggestions        HomeSuggestion[]      @relation("HomeSuggestionReviewer")
  verificationRequests   VerificationRequest[]
  verificationsReviewed  VerificationRequest[] @relation("VerificationReviewer")
  planChanges            PlanChange[]          @relation("PlanChangeUser")
  planChangesBy          PlanChange[]          @relation("PlanChangeAdmin")
  planActivations        PlanActivation[]      @relation("PlanActivationUser")
  planActivationsByAdmin PlanActivation[]      @relation("PlanActivationAdmin")
  pinnedProducts         PinnedProduct[]
  autoBumpSlots          AutoBumpSlot[]
  premiumCarouselDays    PremiumCarouselDay[]
  followerNotifyBatches  FollowerNotifyBatch[]
  savedSearches          SavedSearch[]
  payments               Payment[]             @relation("PaymentUser")
  paymentsCreated        Payment[]             @relation("PaymentAdmin")
  adminActions           AdminAction[]         @relation("AdminActionAdmin")
  emailLogs              EmailLog[]
  qrScans                SellerQrScan[]        @relation("SellerQrScanSeller")
  rol                    Rol?                  @relation(fields: [rolId], references: [id])
  rolId                  String?

  @@map("users")
}

/// Audit + idempotency for outbound emails. Every send (queued, sent, failed,
/// bounced) leaves a row. `dedupeKey` is a per-context natural key
/// (e.g. `plan_activated:{userId}:{planChangeId}`) so retries and duplicate
/// events never send twice.
model EmailLog {
  id            String        @id @default(uuid())
  userId        String?       @map("user_id")
  toEmail       String        @map("to_email") @db.VarChar(255)
  template      EmailTemplate
  subject       String        @db.VarChar(200)
  status        EmailStatus   @default(queued)
  providerMsgId String?       @map("provider_msg_id") @db.VarChar(200)
  error         String?
  dedupeKey     String?       @unique @map("dedupe_key") @db.VarChar(200)
  createdAt     DateTime      @default(now()) @map("created_at")
  sentAt        DateTime?     @map("sent_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@map("email_logs")
}

/// A buyer's saved search: notifies the owner when a newly published product
/// matches the stored criteria.
model SavedSearch {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  query      String?  @db.VarChar(120)
  categoryId String?  @map("category_id")
  city       String?  @db.VarChar(50)
  priceMin   Decimal? @map("price_min") @db.Decimal(12, 2)
  priceMax   Decimal? @map("price_max") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_searches")
}

/// Audit trail of admin actions (hide/suspend/boost/plan change…): who did
/// what to which entity, for accountability once there is more than one admin.
model AdminAction {
  id         String   @id @default(uuid())
  adminId    String?  @map("admin_id")
  action     String   @db.VarChar(40)
  targetType String   @map("target_type") @db.VarChar(20) // product | user | payment
  targetId   String   @map("target_id")
  detail     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  admin User? @relation("AdminActionAdmin", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_actions")
}

/// One-time admin access invitations. A SUPER_ADMIN creates an email + PIN +
/// role; the first successful admin login with that pair grants panel access
/// and assigns the configured role to that existing or newly-created user.
/// Manual-payment ledger: one row per plan purchase or boost, registered when
/// the admin activates it. Source of truth for revenue accounting.
model Payment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("XAF") @db.VarChar(5)
  concept     String   @db.VarChar(30) // plan_star | plan_premium | boost
  note        String?  @db.VarChar(255)
  productId   String?  @map("product_id")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User  @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("PaymentAdmin", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("payments")
}

model Rol {
  id          String   @id @default(uuid())
  label       String   @unique @db.VarChar(320)
  description String?  @db.VarChar(1024)
  users       User[]
  actions     Action[]

  createdById String? @map("user_id")
  createdBy   User?   @relation("User_Create_Rol", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime? @updatedAt @db.Timestamptz

  @@map("roles")
}

model Category {
  id        String     @id @default(uuid())
  label     String
  slug      String     @unique
  color     String?    @db.VarChar(9)
  icon      String?
  parentId  String?
  sortOrder Int        @default(0) @map("sort_order")
  parent    Category?  @relation("MenuToMenu", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("MenuToMenu")
  createdAt DateTime   @default(now()) @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at")

  products Product[]

  @@map("menus")
}

model Product {
  id                String        @id @default(uuid())
  sellerId          String        @map("seller_id")
  categoryId        String        @map("category_id")
  title             String        @db.VarChar(200)
  description       String?
  price             Decimal       @db.Decimal(12, 2)
  discount          Int?          @db.SmallInt
  condition         String?       @db.VarChar(30)
  city              String?       @db.VarChar(50)
  status            ProductStatus @default(active)
  views             Int           @default(0)
  favoritesCount    Int           @default(0) @map("favorites_count")
  contacts          Int           @default(0)
  impressions       Int           @default(0)
  bumpedAt          DateTime      @default(now()) @map("bumped_at")
  boostedUntil      DateTime?     @map("boosted_until")
  /// Set when the seller lowers the price. While `now() < priceReducedUntil`
  /// the product shows the "Rebajado hoy" chip (48h window, Estrella/Premium
  /// only). Cleared automatically on any subsequent price update that is not
  /// a further reduction.
  priceReducedUntil DateTime?     @map("price_reduced_until")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  seller       User               @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category     Category           @relation(fields: [categoryId], references: [id])
  images       ProductImage[]
  attributes   ProductAttribute[]
  favorites    Favorite[]
  reports      Report[]
  viewLogs     ProductView[]
  pinnedBy     PinnedProduct[]
  autoBumpSlot AutoBumpSlot?

  marketplaceDetail MarketplaceDetail?
  vehicleDetail     VehicleDetail?
  propertyDetail    PropertyDetail?
  serviceDetail     ServiceDetail?
  jobDetail         JobDetail?

  @@index([bumpedAt])
  @@index([boostedUntil])
  @@index([priceReducedUntil])
  @@map("products")
}

model ProductView {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  viewerKey String   @map("viewer_key")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // v2 Fase 12 — el unique constraint (productId, viewerKey) se retiró para
  // que el chart "Visitas últimos 7 días" cuente eventos reales (no visitantes
  // únicos por última visita). El dedup de 6h ahora se resuelve con findFirst
  // sobre el índice compuesto orderedBy viewedAt desc. La tabla puede crecer
  // más rápido (una fila por visita >6h del mismo visitante); una limpieza
  // periódica de rows >90d podría añadirse si el volumen lo justifica.
  @@index([productId, viewerKey, viewedAt])
  @@index([viewedAt])
  @@map("product_views")
}

/// Event log for QR-driven visits to a seller's public profile.
/// One row per counted scan; dedup is 30 min by (sellerId, visitorHash) — a
/// findFirst on the composite index keeps refresh/StrictMode double-mounts
/// from inflating the number. Only inserted when the seller's active plan is
/// STAR or PREMIUM; other cases return silently so the client stays simple.
model SellerQrScan {
  id          String   @id @default(uuid())
  sellerId    String   @map("seller_id")
  source      String   @default("qr") @db.VarChar(20)
  visitorHash String?  @map("visitor_hash") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  ipHash      String?  @map("ip_hash") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")

  seller User @relation("SellerQrScanSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@index([sellerId, visitorHash, createdAt])
  @@map("seller_qr_scans")
}

model ProductImage {
  id           String    @id @default(uuid())
  productId    String    @map("product_id")
  url          String
  sortOrder    Int       @default(0) @map("sort_order")
  type         MediaType @default(image)
  thumbnailUrl String?   @map("thumbnail_url")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

enum MediaType {
  image
  video
}

model ProductAttribute {
  id        String @id @default(uuid())
  productId String @map("product_id")
  label     String @db.VarChar(100)
  value     String @db.VarChar(255)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_attributes")
}

model MarketplaceDetail {
  id        String   @id @default(uuid())
  productId String   @unique @map("product_id")
  brand     String?  @db.VarChar(100)
  model     String?  @db.VarChar(100)
  colors    String[] @default([]) @db.VarChar(9)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("marketplace_details")
}

model VehicleDetail {
  id           String   @id @default(uuid())
  productId    String   @unique @map("product_id")
  operation    String?  @db.VarChar(20)
  brand        String?  @db.VarChar(100)
  model        String?  @db.VarChar(100)
  year         Int?     @db.SmallInt
  kilometrage  Int?
  transmission String?  @db.VarChar(20)
  engine       String?  @db.VarChar(20)
  colors       String[] @default([]) @db.VarChar(9)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("vehicle_details")
}

model PropertyDetail {
  id        String  @id @default(uuid())
  productId String  @unique @map("product_id")
  operation String? @db.VarChar(20)
  bedrooms  Int     @default(0) @db.SmallInt
  bathrooms Int     @default(0) @db.SmallInt
  floor     Int     @default(0) @db.SmallInt
  surface   Int     @default(0)
  address   String? @db.VarChar(255)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("property_details")
}

model ServiceDetail {
  id        String  @id @default(uuid())
  productId String  @unique @map("product_id")
  offerType String? @map("offer_type") @db.VarChar(20)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("service_details")
}

model JobDetail {
  id        String  @id @default(uuid())
  productId String  @unique @map("product_id")
  link      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("job_details")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Review {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  sellerId  String   @map("seller_id")
  rating    Int      @db.SmallInt
  text      String?
  createdAt DateTime @default(now()) @map("created_at")

  author User @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  seller User @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Follower {
  id         String   @id @default(uuid())
  followerId String   @map("follower_id")
  followedId String   @map("followed_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed User @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@map("followers")
}

model Notification {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  type             NotificationType
  title            String           @db.VarChar(200)
  body             String?
  read             Boolean          @default(false)
  avatar           String?
  relatedProductId String?          @map("related_product_id")
  relatedUserId    String?          @map("related_user_id")
  sectionId        String?          @map("section_id")
  filterCat        String?          @map("filter_cat")
  createdAt        DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  platform  String?  @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Report {
  id             String       @id @default(uuid())
  type           ReportType
  reason         ReportReason
  description    String?
  status         ReportStatus @default(pending)
  reporterId     String       @map("reporter_id")
  reportedUserId String?      @map("reported_user_id")
  productId      String?      @map("product_id")
  reviewedById   String?      @map("reviewed_by_id")
  reviewedAt     DateTime?    @map("reviewed_at")
  resolutionNote String?      @map("resolution_note")
  createdAt      DateTime     @default(now()) @map("created_at")

  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?    @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewedBy   User?    @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model OtpCode {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  code      String     @db.VarChar(6)
  channel   OtpChannel
  target    String     @db.VarChar(255)
  purpose   String     @db.VarChar(30)
  attempts  Int        @default(0) @db.SmallInt
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_codes")
}

model HomeSection {
  id             String    @id @default(uuid())
  type           String    @db.VarChar(50)
  title          String    @db.VarChar(200)
  subtitle       String?   @db.VarChar(300)
  icon           String?   @db.VarChar(50)
  filter         Json?
  config         Json?
  sortOrder      Int       @default(0) @map("sort_order")
  visible        Boolean   @default(true)
  notifyOnCreate Boolean   @default(false) @map("notify_on_create")
  minResults     Int       @default(0) @map("min_results") @db.SmallInt
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  createdById    String?   @map("created_by_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  createdBy User? @relation("HomeSectionCreator", fields: [createdById], references: [id])

  @@map("home_sections")
}

model HomeSuggestion {
  id           String               @id @default(uuid())
  type         String               @db.VarChar(50)
  title        String               @db.VarChar(200)
  reason       String               @db.VarChar(500)
  filter       Json
  score        Float                @default(0)
  status       HomeSuggestionStatus @default(pending)
  reviewedById String?              @map("reviewed_by_id")
  reviewedAt   DateTime?            @map("reviewed_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  reviewedBy User? @relation("HomeSuggestionReviewer", fields: [reviewedById], references: [id])

  @@map("home_suggestions")
}

model HomeSectionEvent {
  id        String   @id @default(uuid())
  sectionId String   @map("section_id")
  event     String   @db.VarChar(20)
  viewerKey String   @map("viewer_key")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sectionId, event])
  @@map("home_section_events")
}

enum NotificationType {
  like
  price
  verified
  follow
  marketing
  report
  review
  system
  security
  alert
}

enum Action {
  create
  read
  update
  delete
}

enum ProductStatus {
  active
  hide
}

enum PermissionAcces {
  GRANTED
  DENIED
}

enum ReportType {
  product
  user
}

enum ReportReason {
  spam
  scam
  prohibited
  offensive
  fake
  harassment
  other
}

enum ReportStatus {
  pending
  reviewed
  dismissed
}

enum OtpChannel {
  sms
  email
  whatsapp
}

enum HomeSuggestionStatus {
  pending
  accepted
  dismissed
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum UserPlan {
  FREE
  BASIC
  STAR
  PREMIUM
}

enum PlanCycle {
  MONTHLY
  YEARLY
}

enum BumpCadence {
  WEEKLY
  DAILY
}

enum EmailTemplate {
  pin_code
  plan_activated
  boost_receipt
  verification_approved
  verification_rejected
  account_suspended
  welcome
  plan_expiring
  plan_expired
  activity_digest
  comeback
  admin_weekly_summary
}

enum EmailStatus {
  queued
  sent
  failed
  bounced
}

model VerificationRequest {
  id             String             @id @default(uuid())
  userId         String             @map("user_id")
  status         VerificationStatus @default(pending)
  /// URLs of uploaded documents (ID card, business licence, selfie holding ID,
  /// etc.). Stored as an array so the admin sees the full evidence packet in
  /// one place. Files themselves live in the upload bucket.
  docs           String[]           @default([])
  rejectedReason String?            @map("rejected_reason")
  reviewedById   String?            @map("reviewed_by_id")
  reviewedAt     DateTime?          @map("reviewed_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@map("verification_requests")
}

model PlanChange {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  oldPlan     UserPlan  @map("old_plan")
  newPlan     UserPlan  @map("new_plan")
  expiresAt   DateTime? @map("expires_at")
  reason      String?   @db.VarChar(500)
  changedById String    @map("changed_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User @relation("PlanChangeUser", fields: [userId], references: [id], onDelete: Cascade)
  changedBy User @relation("PlanChangeAdmin", fields: [changedById], references: [id])

  @@index([userId])
  @@map("plan_changes")
}

/// Manual plan activation with full pricing metadata. One row per activation:
/// captures unit price, months, discount and total paid so the admin can
/// reconstruct any past charge. Complements (does not replace) `PlanChange`
/// (which stays as a lightweight audit log) and `Payment` (which stays as the
/// revenue ledger). See docs/plans-v2-decisions.md.
model PlanActivation {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  plan               UserPlan
  months             Int      @db.SmallInt
  /// Unit price in XAF at the time of activation (snapshot). Not a foreign key
  /// so a later PLAN_PRICES change never rewrites history.
  unitPrice          Decimal  @map("unit_price") @db.Decimal(12, 2)
  /// Discount applied as a fraction (0.05 = 5 %).
  discountPct        Decimal  @map("discount_pct") @db.Decimal(5, 4)
  totalPaid          Decimal  @map("total_paid") @db.Decimal(12, 2)
  activatedByAdminId String?  @map("activated_by_admin_id")
  activatedAt        DateTime @default(now()) @map("activated_at")
  startsAt           DateTime @map("starts_at")
  endsAt             DateTime @map("ends_at")
  notes              String?  @db.VarChar(500)

  user             User  @relation("PlanActivationUser", fields: [userId], references: [id], onDelete: Cascade)
  activatedByAdmin User? @relation("PlanActivationAdmin", fields: [activatedByAdminId], references: [id], onDelete: SetNull)

  @@index([userId, activatedAt])
  @@index([activatedAt])
  @@map("plan_activations")
}

/// Products a seller has pinned to the top of their profile. Limits per plan:
/// Estrella = 4, Premium = 10. Free and Basic have no pinned slots. `position`
/// is a 0-indexed slot within the seller's profile; @@unique([userId, position])
/// prevents two products in the same slot. Gaps between positions are allowed.
model PinnedProduct {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, position])
  @@unique([userId, productId])
  @@map("pinned_products")
}

/// A product a seller has added to their auto-bump pool. The cron re-stamps
/// `Product.bumpedAt` on the slot's cadence (Estrella = weekly, Premium =
/// daily). Pool sizes: Estrella = 3, Premium = 5. Enforced at write time.
model AutoBumpSlot {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  productId String      @unique @map("product_id")
  cadence   BumpCadence
  createdAt DateTime    @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auto_bump_slots")
}

/// The 3 products picked for a Premium seller's slot in the home carousel on a
/// given day. Written by the daily cron at 00:00 GMT+1 with a fairness rule so
/// every active product appears >=2 days/week. History kept for at least 30
/// days for audit.
model PremiumCarouselDay {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  day        DateTime @db.Date
  productIds String[] @map("product_ids")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
  @@map("premium_carousel_days")
}

/// One row per grouped push notification sent to a seller's followers about
/// newly published products. Aggregator emits at most one batch per seller per
/// 6h window (see docs/plans-v2-decisions.md). `productIds` is the set of
/// products included in that batch.
model FollowerNotifyBatch {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  batchedAt  DateTime @default(now()) @map("batched_at")
  productIds String[] @map("product_ids")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, batchedAt])
  @@map("follower_notify_batches")
}

/// Singleton row (id = "singleton") holding the platform-wide promotional
/// override: while it is active every seller is *entitled* to the features of
/// `grantedPlan` regardless of what they pay for, and paid modules can be
/// switched to free one by one. Their stored `plan` is untouched, so badges,
/// the premium carousel and the billing ledger keep reflecting reality — the
/// promo only widens what a seller is allowed to do.
model PlanPromo {
  id          String   @id @default("singleton")
  /// Master switch. The promo is only in force when this is true AND `now`
  /// falls inside the [startsAt, endsAt] window (null bound = open-ended).
  enabled     Boolean  @default(false)
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  /// Plan whose limits everyone gets while the promo runs.
  grantedPlan UserPlan @default(PREMIUM) @map("granted_plan")

  /// Per-module switches, so cobros can be re-enabled by phases.
  unlockLimits   Boolean @default(true) @map("unlock_limits")
  unlockPinned   Boolean @default(true) @map("unlock_pinned")
  unlockAutoBump Boolean @default(true) @map("unlock_auto_bump")
  unlockStats    Boolean @default(true) @map("unlock_stats")
  freeBoosts     Boolean @default(true) @map("free_boosts")

  /// Copy shown in the apps' promo banner. Null = clients use their default.
  bannerText String?  @map("banner_text") @db.VarChar(160)

  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("plan_promo")
}
